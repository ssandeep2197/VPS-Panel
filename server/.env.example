# Generate a real .env with:  npm run setup -- --username admin --password 'your-password'

# --- HTTP ---
# Keep 127.0.0.1 and put nginx/caddy with HTTPS in front. Use 0.0.0.0 only behind a firewall/VPN.
HOST=127.0.0.1
PORT=4600
# Set to 1 when running behind a reverse proxy so client IPs are read from X-Forwarded-For
TRUST_PROXY=0

# --- Auth ---
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (created by `npm run setup`)
ADMIN_PASSWORD_HASH=
# At least 32 random characters
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- systemd ---
# Run systemctl/journalctl through `sudo -n` when the panel is not running as root
USE_SUDO=false
# Services that can never be stopped or disabled from the UI (prevents locking yourself out)
PROTECTED_SERVICES=ssh,sshd,vps-panel

# --- Docker ---
# Leave empty to use DOCKER_HOST or the default /var/run/docker.sock
DOCKER_SOCKET=

# --- Kubernetes ---
# Path to kubectl. It uses the default kubeconfig of the user running the panel (k3s: root).
KUBECTL_BIN=kubectl
# Workloads in these namespaces cannot be scaled from the UI (scaling the ingress to 0 locks you out)
PROTECTED_NAMESPACES=kube-system,ingress-nginx,cert-manager

# Where the Requests page reads the nginx access log from
INGRESS_NAMESPACE=ingress-nginx
INGRESS_WORKLOAD=deploy/ingress-nginx-controller

# --- Kafka ---
# Comma separated list, e.g. localhost:9092
KAFKA_BROKERS=
# The Docker container running the broker ("tms-kafka-1" or "<compose project>/<service>"): the panel then connects
# to the broker's hostname at the container's current address, so no /etc/hosts entry is needed and a redeploy that
# moves the container keeps working. Leave empty when the brokers are reachable by name.
KAFKA_CONTAINER=
KAFKA_CLIENT_ID=vps-panel
KAFKA_SSL=false
# plain | scram-sha-256 | scram-sha-512 (leave empty for no SASL)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Sign in with TMS (OpenID Connect) ---
# The TMS platform is the identity provider; the panel is an app registered on its admin portal (Apps page, client id
# vps-panel, redirect URL <PUBLIC_URL>/auth/callback). People sign in on the TMS page; who may open the panel, and as
# which role, is set per account on the admin portal's Access page (owners need no grant). On when all three are set.
PUBLIC_URL=https://panel.example.com
# How the sign-in is named on the login screens ("Sign in with HW", "HW account")
TMS_NAME=HW
TMS_ISSUER=https://admin.helloworlds.co.in/platform/oidc
TMS_CLIENT_ID=vps-panel
# Shown once when the app is registered; keep it here only (never in the repository)
TMS_CLIENT_SECRET=
TMS_SCOPES=openid email profile roles
# Roles that may change things; any other role (e.g. viewer) is read-only
TMS_ADMIN_ROLES=owner,admin
# The panel's own session after a TMS sign-in, in hours
TMS_SESSION_HOURS=8
# Signing out of the panel also ends the TMS single sign-on (its 8-hour cookie)
TMS_LOGOUT_EVERYWHERE=true
# The panel's own admin login (ADMIN_USERNAME/ADMIN_PASSWORD_HASH) stays available as the fallback when TMS is
# down; set to false to allow TMS sign-ins only.
PASSWORD_LOGIN=true

# --- Sites (health checks of every hostname served by the ingress) ---
# Extra hostnames to check that are not ingress rules in the cluster, comma separated
SITES=
# Server public IP for the DNS check; detected from the ingress controller when empty
PUBLIC_IP=
# Screenshot thumbnails are taken with headless Chromium in a throwaway Docker container
THUMBNAILS=true
THUMBNAIL_IMAGE=zenika/alpine-chrome:latest
THUMBNAIL_BIN=chromium-browser

# --- Storage ---
# Where the audit log is written (defaults to server/data)
DATA_DIR=
