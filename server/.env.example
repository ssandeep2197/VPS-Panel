# Generate a real .env with:  npm run setup -- --username admin --password 'your-password'

# --- HTTP ---
# Keep 127.0.0.1 and put nginx/caddy with HTTPS in front. Use 0.0.0.0 only behind a firewall/VPN.
HOST=127.0.0.1
PORT=4600
# Set to 1 when running behind a reverse proxy so client IPs are read from X-Forwarded-For
TRUST_PROXY=0

# --- Auth ---
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (created by `npm run setup`)
ADMIN_PASSWORD_HASH=
# At least 32 random characters
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- systemd ---
# Run systemctl/journalctl through `sudo -n` when the panel is not running as root
USE_SUDO=false
# Services that can never be stopped or disabled from the UI (prevents locking yourself out)
PROTECTED_SERVICES=ssh,sshd,vps-panel

# --- Docker ---
# Leave empty to use DOCKER_HOST or the default /var/run/docker.sock
DOCKER_SOCKET=

# --- Kubernetes ---
# Path to kubectl. It uses the default kubeconfig of the user running the panel (k3s: root).
KUBECTL_BIN=kubectl
# Workloads in these namespaces cannot be scaled from the UI (scaling the ingress to 0 locks you out)
PROTECTED_NAMESPACES=kube-system,ingress-nginx,cert-manager

# Where the Requests page reads the nginx access log from
INGRESS_NAMESPACE=ingress-nginx
INGRESS_WORKLOAD=deploy/ingress-nginx-controller

# --- Kafka ---
# Comma separated list, e.g. localhost:9092
KAFKA_BROKERS=
KAFKA_CLIENT_ID=vps-panel
KAFKA_SSL=false
# plain | scram-sha-256 | scram-sha-512 (leave empty for no SASL)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Storage ---
# Where the audit log is written (defaults to server/data)
DATA_DIR=
